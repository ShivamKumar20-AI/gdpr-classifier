# Example environment variables
# Copy this file to .env and add real values locally.
# Never commit the .env file.

# Example future API key:
# GROQ_API_KEY=your_api_key_here

# Optional. Without it the admin history tab is not shown.
# ADMIN_PASSWORD=choose_a_long_random_password

# Optional. Keeps hashes comparable between restarts; a random one is used if unset.
# HASH_SALT=choose_a_long_random_string
